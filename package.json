{
  "name": "@usace/groundwork-geo",
  "version": "2.1.2",
  "type": "module",
  "description": "A mapping library to accompany groundwork",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/USACE/groundwork-geo.git"
  },
  "main": "./dist/groundwork-geo.umd.cjs",
  "module": "./dist/es/index.js",
  "exports": {
    ".": {
      "import": "./dist/es/index.js",
      "require": "./dist/groundwork-geo.umd.cjs"
    },
    "./groundwork-geo.css": "./dist/groundwork-geo.css"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build-lib",
    "build-lib": "vite build -m lib",
    "pub": "npm run build-lib && npm publish --access=public",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests"
  },
  "dependencies": {
    "money-clip": "^3.0.5",
    "ol": "^10.2.1",
    "react-icons": "^5.0.1",
    "redux-bundler": "^28.1.0",
    "redux-bundler-hook": "^1.0.3",
    "redux-bundler-react": "^1.2.0",
    "styled-components": "^6.1.13"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.12"
  }
}
